# Copy to .env and fill in the real values. db.js loads this file on startup
# (Node's built-in process.loadEnvFile); on the VPS these vars may instead be
# injected by pm2. .env is git-ignored – never commit real credentials.

# PostgreSQL connection (matches the VPS setup: DB "faaglarna", app user
# "faaglarna_app").
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=faaglarna
PGUSER=faaglarna_app
PGPASSWORD=change-me

# HTTP server (behind nginx on the VPS).
PORT=3001
HOST=127.0.0.1

# The stateless Python export sidecar (see ../export-service/). Localhost only.
# Leave empty to disable server-side exports; the frontend then falls back to
# browser print, exactly as the offline build does.
EXPORT_SERVICE_URL=http://127.0.0.1:3002

# Extra browser origins allowed to call this API, comma-separated.
#
# REQUIRED for this deployment. Any *.github.io origin and any localhost port are
# allowed automatically, but the frontend lives on a CUSTOM domain, which is not
# covered by either rule — so it must be listed here explicitly or every request
# from the app fails CORS with no obvious cause.
ALLOWED_ORIGINS=https://faaglarna.lektorensrud.no
